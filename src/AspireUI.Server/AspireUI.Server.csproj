<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Aspire.Hosting.AppHost's build props default IsPublishable=false (meant for orchestrator
         AppHost projects). This is a normal web app that must publish, so force it back on. -->
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Yarp.ReverseProxy" />
    <PackageReference Include="YamlDotNet" />
    <!-- gRPC client for the Aspire "resource service" (aspire.v1.DashboardService) — live per-resource
         status/urls/relationships + console logs of a running stack. Proto is compiled here (Aspire
         ships it only inside Aspire.Hosting.dll as internal types, so we generate our own client). -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <!-- Catalog breadth: the server references these purely so reflection can surface their AddX
         resources; a generated stack only references the packages for resources it actually uses. -->
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <PackageReference Include="Aspire.Hosting.MySql" />
    <PackageReference Include="Aspire.Hosting.MongoDB" />
    <PackageReference Include="Aspire.Hosting.Kafka" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Nats" />
    <PackageReference Include="Aspire.Hosting.Elasticsearch" />
    <PackageReference Include="Aspire.Hosting.Keycloak" />
    <PackageReference Include="Aspire.Hosting.Seq" />
    <PackageReference Include="Aspire.Hosting.Valkey" />
    <PackageReference Include="Aspire.Hosting.Garnet" />
    <PackageReference Include="Aspire.Hosting.Qdrant" />
    <PackageReference Include="Aspire.Hosting.Milvus" />
    <PackageReference Include="Aspire.Hosting.Azure.CosmosDB" />
    <PackageReference Include="Aspire.Hosting.Yarp" />
    <PackageReference Include="Aspire.Hosting.Oracle" />
    <PackageReference Include="Aspire.Hosting.Python" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" />
    <PackageReference Include="Aspire.Hosting.Azure.KeyVault" />
    <PackageReference Include="Aspire.Hosting.Azure.ApplicationInsights" />
    <PackageReference Include="Aspire.Hosting.Azure.CognitiveServices" />
    <PackageReference Include="Aspire.Hosting.Maui" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Java" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.ActiveMQ" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Golang" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Dapr" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.MinIO" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Meilisearch" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.RavenDB" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.MailPit" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Adminer" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ngrok" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Bun" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Deno" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Rust" />
    <PackageReference Include="Nextended.Aspire" />
    <PackageReference Include="Nextended.Aspire.Hosting.LocalAI" />
    <PackageReference Include="Nextended.Aspire.Hosting.N8n" />
    <PackageReference Include="Nextended.Aspire.Hosting.Php" />
    <PackageReference Include="Nextended.Aspire.Hosting.Supabase" />
    <PackageReference Include="Nextended.Aspire.Hosting.Grafana" />
    <PackageReference Include="Nextended.Aspire.Hosting.AspireUI" />
  </ItemGroup>

  <ItemGroup>
    <!-- Central package versions (single source of truth). Copied to output so codegen can stamp the
         same versions into generated stack .csproj files at runtime. -->
    <None Include="../../Directory.Packages.props" Link="Directory.Packages.props" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/dashboard_service.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- catalog/*.json is already picked up by the SDK's default Content items (like appsettings.json);
         Update (not Include) just adds CopyToOutputDirectory without duplicating the item. -->
    <Content Update="catalog\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Bundled app media (logos/cards/screenshots) served under /media at runtime. -->
    <Content Include="catalog\media\**\*.webp;catalog\media\**\*.png;catalog\media\**\*.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Defensive: never compile generated stack projects if a workspace ever lands under the project dir.
         The default WORKSPACE_DIR is outside the project (LocalApplicationData), but WORKSPACE_DIR can be
         overridden; without this the SDK.Web **/*.cs glob would pull generated Program.cs into our build. -->
    <Compile Remove="workspace/**/*.cs" />
    <Content Remove="workspace/**" />
    <None Remove="workspace/**" />
  </ItemGroup>

  <!-- Only build the SPA for Release (the real deployable). Debug/test builds stay fast and node-free. -->
  <Target Name="BuildSpa" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="npm install" WorkingDirectory="../../web" />
    <Exec Command="npm run build" WorkingDirectory="../../web" />
    <ItemGroup>
      <SpaFiles Include="../../web/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(SpaFiles)" DestinationFolder="wwwroot/%(RecursiveDir)" />
  </Target>

</Project>
